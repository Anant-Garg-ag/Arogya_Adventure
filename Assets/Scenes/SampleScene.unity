  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a3d77a257f650794fb1bfd221e547049, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteractable
  npcName: Village Elder
  promptVerb: Talk to
  dialogueLine: Greetings, traveler. A grave affliction has fallen upon Arogya Gram. The well is tainted, and our people are weakening.
  displayDuration: 5
  isVillageElder: 1
  mission1IncompleteDialogue: I am worried about the sickness spreading through our village. Please bring me three Tulsi leaves from near the stream.
  mission1CompleteDialogue: Thank you. The Tulsi will help us prepare a remedy. Now, I need you to investigate the village well. Something is wrong with its water.
  mission2ActiveDialogue: Please inspect the village well. We must discover why its water is tainted.
  isInteractable: 1
  onTalk:
    m_PersistentCalls:
      m_Calls: []
